# ===== LLM 接入（OpenAI 兼容接口；不配置则自动使用规则/mock 模式） =====
# 智谱开放平台示例（glm-4-flash 免费）：
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=your-api-key
# LLM_MODEL=glm-4-flash

# DeepSeek 示例：
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=deepseek-chat

# 本地 Ollama 示例：
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ===== 数据库连接（默认 SQLite；切换 PostgreSQL/MySQL 见 docs/数据库切换指南.md） =====
# DATABASE_URL=sqlite:///data/copilot.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/logistics_copilot?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/logistics_copilot
