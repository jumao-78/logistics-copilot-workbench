@echo off
rem ============================================================
rem  Logistics Copilot 一键启动（跨境物流智能客服工作台）
rem  双击运行：自动启动后端服务并打开浏览器（端口 8010）
rem  关闭方法：直接关闭本命令行窗口即可
rem ============================================================
chcp 65001 >nul
cd /d "%~dp0"

echo [1/2] 启动服务中...（首次启动需等待几秒）
start "" http://127.0.0.1:8010
python -m uvicorn app.main:app --host 127.0.0.1 --port 8010

echo.
echo 服务已退出。如果是端口占用报错，请先关闭旧的命令行窗口再试。
pause
